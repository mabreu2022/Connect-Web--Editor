{
  "nome": "MVC Simples",
  "descricao": "Arquitetura MVC com Grid de listagem e formulário de cadastro separados. Camadas: Model (POPO), DAO (SQL+Generator), Controller (interface), View (TStringGrid + TEdit). Ideal para sistemas simples e diretos.",
  "versao": "1.1",
  "autor": "Gerador de Sistemas Lazarus",
  "pastas": ["model", "dao", "controller", "interface", "view", "dm", "utils"],
