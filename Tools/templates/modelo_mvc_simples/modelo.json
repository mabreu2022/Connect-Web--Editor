    {"tpl": "dm_conexao.tpl",       "saida": "dm/uDMConexao.pas"},
    {"tpl": "dm_conexao_lfm.tpl",   "saida": "dm/uDMConexao.lfm"},
    {"tpl": "utils.tpl",            "saida": "utils/uUtils.pas"},
    {"tpl": "types.tpl",            "saida": "utils/uTypes.pas"},
    {"tpl": "project_lpr.tpl",      "saida": "{{NOME_SISTEMA}}.lpr"}
  ],
  "por_tabela": [
    {"tpl": "model.tpl",            "saida": "model/uModel{{T}}.pas"},
