    {"tpl": "view_lista.tpl",       "saida": "view/uView{{T}}Lista.pas"},
    {"tpl": "view_lista_lfm.tpl",   "saida": "view/uView{{T}}Lista.lfm"},
    {"tpl": "view_form.tpl",        "saida": "view/uView{{T}}Form.pas"},
